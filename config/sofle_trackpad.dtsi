/*
 * Cirque GlidePoint TM023023 (Pinnacle ASIC, I2C) trackpad on the RIGHT half,
 * wired to the OLED header in place of the right-hand display.
 *
 * Shared by both halves: the right (peripheral) half forwards trackpad events
 * through the input split below, and the left (central) half receives them and
 * sends them to the host via the listener.
 */

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split: trackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpad_split>;
    };
};
